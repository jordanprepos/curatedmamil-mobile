# Firebase web SDK config for the Mami L dashboard.
#
# These are not secrets — a Firebase web config is meant to ship in the client,
# and firebase/firestore.rules is the real access boundary. .env is still kept
# out of version control so each environment points at its own project.
#
# Get these values with:  npx firebase-tools apps:sdkconfig web --project <id>
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
